# Variables del entorno de staging (A6.12).
#
# Copie este archivo como `.env.staging`, complete los secretos y no lo
# versione: está en `.gitignore` y en `.dockerignore`.
#
#   Copy-Item .env.staging.example .env.staging
#
# Generar los secretos (una sola vez, guardarlos en el gestor de secretos):
#
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"   # SECRET_KEY
#   uv run python -c "import secrets; print(secrets.token_urlsafe(24))"   # AUTH_PEPPER

# --- Entorno ------------------------------------------------------------------
# `staging` valida la configuración y solo advierte (no bloquea el pipeline).
# `prod` falla cerrada si falta cualquier requisito de endurecimiento.
EET_ENVIRONMENT=staging

# --- Autenticación ------------------------------------------------------------
# Activa gate, CSRF, roles y 2FA. Es el objeto del ensayo A6.12.
EET_AUTH_ENABLED=true

# Cookie `Secure` sobre HTTPS y nombre con prefijo `__Host-` (exige Secure,
# Path=/ y ningún Domain).
EET_COOKIE_SECURE=true
EET_SESSION_COOKIE=__Host-eet_session

# Secretos: mínimo 32 y 16 caracteres respectivamente. Vacíos a propósito.
EET_SECRET_KEY=
EET_AUTH_PEPPER=

# Rotación de claves de cifrado (opcional). Formato `v2:<nueva>,v1:<vieja>`;
# la primera cifra y todas descifran. Ver docs/runbook-autenticacion.md §9.
# EET_FERNET_KEYS=

# Vida de la sesión: 12 h absolutas, 30 min de inactividad.
EET_SESSION_ABSOLUTE_MIN=720
EET_SESSION_IDLE_MIN=30

# --- URL pública y red --------------------------------------------------------
# Debe coincidir con el esquema, host y puerto que ve el navegador: arma los
# enlaces del correo y decide si la cookie lleva prefijo `__Host-`.
EET_PUBLIC_BASE_URL=https://localhost:8443

# IP fija del contenedor `proxy` en la red de staging (172.28.0.0/24). Solo
# desde ella se aceptan `X-Forwarded-Proto/For`: sin esto la app no detectaría
# HTTPS (ni emitiría HSTS) y todos los clientes compartirían IP en auditoría.
EET_TRUSTED_PROXY_IPS=172.28.0.10/32

# En el ensayo la administración se abre desde el host (la IP de origen es la
# puerta de enlace de Docker). En producción debe ser `true` con los CIDR
# internos reales.
EET_ADMIN_INTERNAL_ONLY=false
EET_INTERNAL_CIDRS=172.28.0.0/24,127.0.0.1/32

# --- Base de datos ------------------------------------------------------------
# Dentro de la red de staging el servicio se llama `db` (puerto interno 5432).
EET_DATABASE_URL=postgresql+psycopg://eet:eet@db:5432/eet

# --- Correo -------------------------------------------------------------------
# Staging no envía correo real: el backend `console` registra destinatario y
# asunto (nunca el cuerpo). El preflight lo marca como aviso, no como fallo.
# En producción: `smtp` + EET_SMTP_HOST/USER/PASSWORD y SPF/DKIM/DMARC.
EET_EMAIL_BACKEND=console
# EET_EMAIL_DIR=uploads/mail
EET_EMAIL_FROM="Validador EET <no-reply@localhost>"
# EET_SMTP_HOST=
# EET_SMTP_PORT=587
# EET_SMTP_STARTTLS=true
# EET_SMTP_USER=
# EET_SMTP_PASSWORD=

# --- Endurecimiento -----------------------------------------------------------
# `/docs` y `/openapi.json` no se publican con la autenticación activa.
EET_EXPOSE_DOCS=false
EET_MAX_UPLOAD_MB=20

# Límites de intentos (valores por defecto; se dejan explícitos para el ensayo).
EET_LOGIN_MAX_INTENTOS=5
EET_LOGIN_BLOQUEO_MIN=15
EET_LOGIN_IP_MAX_15MIN=20
EET_MFA_ISSUER=Validador EET (AEP)
EET_MFA_WINDOW=1

# --- LDAP / AD ----------------------------------------------------------------
# Apagado: no se abre ninguna conexión y las cuentas son locales.
EET_LDAP_ENABLED=false
